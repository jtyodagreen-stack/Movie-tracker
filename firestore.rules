rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCustomFilter(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.name is string && data.name.size() <= 128 && data.name.size() > 0
          && (!('status' in data) || data.status is string)
          && (!('platform' in data) || data.platform is string);
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    match /custom_filters/{filterId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidCustomFilter(request.resource.data) && isValidId(filterId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidCustomFilter(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
